# Decision model: typesafe (default) or deepseek. Both answer operation + targets in one request.
DECISION_PROVIDER=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# deepseek provider (used when DECISION_PROVIDER=deepseek). Thinking is disabled automatically.
# DEEPSEEK_OUTPUT=prompt enforces the json contract by system prompt; json uses response_format json mode.
DECISION_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_OUTPUT=prompt
# TYPE_TEXT helper: defaults to DeepSeek (thinking disabled); an unset key falls back to DEEPSEEK_API_KEY.
# Any OpenAI-compatible endpoint works; OpenRouter example: base https://openrouter.ai/api/v1,
# model inception/mercury-2.5, TEXT_MODEL_REASONING=none.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-flash
